# The gateway's own API key. The Discord bot and the completion relay send this
# in the X-API-Key header.
API_KEY=

# API bind (defaults shown)
API_HOST=0.0.0.0
API_PORT=8000

# Downstream worker: torrent-downloader. In Docker, the host is the service
# name on the shared compose network. The key must equal that service's API_KEY.
TORRENT_DOWNLOADER_URL=http://torrent-downloader:8000
TORRENT_DOWNLOADER_API_KEY=

# Downstream worker: medialab-jellyfin (listens on 8001). The key must equal
# that service's API_KEY.
MEDIALAB_JELLYFIN_URL=http://medialab-jellyfin:8001
MEDIALAB_JELLYFIN_API_KEY=

# In-container path of the host media dir bind-mounted into this container.
# Used to compute TV-rename source/dest. The downloaded folder is
# MEDIA_MOUNT_PATH/<media-type-subdir>/<release_name>.
MEDIA_MOUNT_PATH=/media

# SQLite job-store file. Lives on a mounted volume so jobs survive restarts.
DB_PATH=./data/orchestrator.db

# Health poll: every N seconds, resume errored downloads, run the pipeline for
# completions the webhook missed, retry failed jobs, and flag what is past its
# budget as NEEDS_ATTENTION. 0 disables the poll. Defaults shown.
HEALTH_POLL_INTERVAL_SECONDS=300
AUTO_RESUME_MAX=3
AUTO_RETRY_MAX=2
