# The gateway's own API key. The Discord bot and the completion relay send this
# in the X-API-Key header.
API_KEY=

# API bind (defaults shown)
API_HOST=0.0.0.0
API_PORT=8000

# Downstream worker: torrent-downloader. It runs inside the gluetun VPN
# namespace, so it is reached through the gluetun service name on the port it
# listens on there (8001; gluetun's own control server holds 8000). The key
# must equal that service's API_KEY.
TORRENT_DOWNLOADER_URL=http://gluetun:8001
TORRENT_DOWNLOADER_API_KEY=

# Downstream worker: medialab-jellyfin (listens on 8001). The key must equal
# that service's API_KEY.
MEDIALAB_JELLYFIN_URL=http://medialab-jellyfin:8001
MEDIALAB_JELLYFIN_API_KEY=

# In-container path of the host media dir bind-mounted into this container.
# Used to compute TV-rename source/dest. The downloaded folder is
# MEDIA_MOUNT_PATH/<media-type-subdir>/<release_name>.
MEDIA_MOUNT_PATH=/media

# SQLite job-store file. Lives on a mounted volume so jobs survive restarts.
DB_PATH=./data/orchestrator.db
# Runtime setting overrides made through the API persist here (same volume).
SETTINGS_PATH=./data/settings.json
# Last seen credential states and the bot's login report; drives one Discord
# notice per change rather than one per poll.
CREDENTIALS_PATH=./data/credentials.json

# Health poll: every N seconds, resume errored downloads, run the pipeline for
# completions the webhook missed, retry failed jobs, and flag what is past its
# budget as NEEDS_ATTENTION. 0 disables the poll. Defaults shown.
HEALTH_POLL_INTERVAL_SECONDS=300
AUTO_RESUME_MAX=3
AUTO_RETRY_MAX=2

# Follow poll: every N seconds, fetch the wanted episodes of every unpaused
# followed show through torrent-downloader's automatic pick. 0 pauses the
# poll. An episode is wanted FOLLOW_DELAY_HOURS after its air date; picks need
# at least FOLLOW_MINIMUM_SEEDERS; one show submits at most
# FOLLOW_MAX_SUBMISSIONS_PER_TICK per tick. All four are runtime settings
# too (PUT /settings/medialab-orchestrator/<key>). Defaults shown.
FOLLOW_POLL_INTERVAL_SECONDS=21600
FOLLOW_MAX_SUBMISSIONS_PER_TICK=3
FOLLOW_DELAY_HOURS=12
FOLLOW_MINIMUM_SEEDERS=50
# A follow fetches a complete season as one pack when nothing of it has been
# fetched yet: FOLLOW_PACK_* is the standard pack profile, FOLLOW_PACK_RETRY_*
# the two profiles the user may choose when no pack was found. Runtime
# settings too. Defaults shown.
FOLLOW_PACK_MINIMUM_SEEDERS=20
FOLLOW_PACK_TIMEOUT_SECONDS=30
FOLLOW_PACK_RETRY_TIMEOUT_SECONDS=90
FOLLOW_PACK_RETRY_MINIMUM_SEEDERS=5

# Optional. A Discord channel webhook URL; every follow submission posts a
# one-line notice to it. Leave empty for no notice. See docs/secrets.md in
# the workspace for where to create one.
DISCORD_NOTIFY_WEBHOOK_URL=
